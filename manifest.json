{
  "manifest_version": 3,
  "name": "Safe Image Save",
  "version": "0.1.2",
  "description": "Save web images as PNG, JPG, WebP, or AVIF with local-only conversion.",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "downloads",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Safe Image Save"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
